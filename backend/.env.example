# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI
GEMINI_API_KEY=
TAVILY_API_KEY=

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
